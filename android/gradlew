#!/usr/bin/env sh
# Lightweight Gradle bootstrap for environments where the Wrapper JAR is unavailable.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.9
GRADLE_HOME="${GRADLE_USER_HOME:-${HOME}/.gradle}/copilot-bootstrap/gradle-${GRADLE_VERSION}"
if [ ! -x "${GRADLE_HOME}/bin/gradle" ]; then
  mkdir -p "$(dirname "${GRADLE_HOME}")"
  ARCHIVE="${TMPDIR:-/tmp}/gradle-${GRADLE_VERSION}-$$.zip"
  URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${URL}" -o "${ARCHIVE}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "${URL}" -O "${ARCHIVE}"
  else
    echo "curl or wget is required to download Gradle ${GRADLE_VERSION}" >&2
    exit 1
  fi
  mkdir -p "$(dirname "${GRADLE_HOME}")"
  unzip -q "${ARCHIVE}" -d "$(dirname "${GRADLE_HOME}")"
  rm -f "${ARCHIVE}"
fi
exec "${GRADLE_HOME}/bin/gradle" -p "${APP_HOME}" "$@"
